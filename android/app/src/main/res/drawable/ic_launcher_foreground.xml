<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：与 assets/branding/bilimuse-icon.svg 共用 108×108 坐标。
  整体缩放 2/3 是为了适配自适应图标 72dp 的可见安全区，
  这样在启动器里看到的唱片/音符比例与桌面版一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
